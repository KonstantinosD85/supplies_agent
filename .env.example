# Copy to .env and fill in. .env is git-ignored.
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown)
# AGENT_MODEL_PROVIDER=anthropic   # or bedrock (uses the standard AWS credentials)
# AGENT_MODEL_ID=claude-sonnet-5-5
# AGENT_MCP_URL=http://127.0.0.1:8002/mcp
# AGENT_DB_PATH=data/agent.db
# AGENT_SESSION_RETENTION_DAYS=30

# docker compose: the key the MCP server uses to call the mock API (both sides read it)
# MOCK_API_KEY=dev-mock-key

# Evals judge model (python -m evals)
# EVAL_JUDGE_MODEL_ID=claude-haiku-5-5
